#include <Arduino.h>
#include <stdint.h>

// ============================================================
// 32個のセンサ入力
//
// bit  0 : PB7
// bit  1 : PB6
// bit  2 : PB5
// bit  3 : PB4
// bit  4 : PB0
// bit  5 : PH6
// bit  6 : PH5
// bit  7 : PH4
// bit  8 : PH3
// bit  9 : PH2
// bit 10 : PF6
// bit 11 : PF7
// bit 12 : PA1
// bit 13 : PA2
// bit 14 : PJ6
// bit 15 : PJ5
// bit 16 : PJ4
// bit 17 : PJ3
// bit 18 : PC5
// bit 19 : PC4
// bit 20 : PC3
// bit 21 : PC2
// bit 22 : PC1
// bit 23 : PC0
// bit 24 : PG1
// bit 25 : PG0
// bit 26 : PL3
// bit 27 : PL2
// bit 28 : PL1
// bit 29 : PL0
// bit 30 : PG3
// bit 31 : PH7
//
// 物理HIGH -> 1
// 物理LOW  -> 0
// ============================================================


// ============================================================
// センサ入力をINPUT_PULLUPに設定
// ============================================================
void initSensors()
{
    // --------------------------------------------------------
    // PORTB
    // PB7, PB6, PB5, PB4, PB0
    // --------------------------------------------------------
    constexpr uint8_t MASK_B =
        (1 << PB7) |
        (1 << PB6) |
        (1 << PB5) |
        (1 << PB4) |
        (1 << PB0);

    DDRB  &= ~MASK_B;   // INPUT
    PORTB |=  MASK_B;   // PULLUP ON


    // --------------------------------------------------------
    // PORTH
    // PH6, PH5, PH4, PH3, PH2, PH7
    // --------------------------------------------------------
    constexpr uint8_t MASK_H =
        (1 << PH6) |
        (1 << PH5) |
        (1 << PH4) |
        (1 << PH3) |
        (1 << PH2) |
        (1 << PH7);

    DDRH  &= ~MASK_H;   // INPUT
    PORTH |=  MASK_H;   // PULLUP ON


    // --------------------------------------------------------
    // PORTF
    // PF6, PF7
    // --------------------------------------------------------
    constexpr uint8_t MASK_F =
        (1 << PF6) |
        (1 << PF7);

    DDRF  &= ~MASK_F;   // INPUT
    PORTF |=  MASK_F;   // PULLUP ON


    // --------------------------------------------------------
    // PORTA
    // PA1, PA2
    // --------------------------------------------------------
    constexpr uint8_t MASK_A =
        (1 << PA1) |
        (1 << PA2);

    DDRA  &= ~MASK_A;   // INPUT
    PORTA |=  MASK_A;   // PULLUP ON


    // --------------------------------------------------------
    // PORTJ
    // PJ6, PJ5, PJ4, PJ3
    // --------------------------------------------------------
    constexpr uint8_t MASK_J =
        (1 << PJ6) |
        (1 << PJ5) |
        (1 << PJ4) |
        (1 << PJ3);

    DDRJ  &= ~MASK_J;   // INPUT
    PORTJ |=  MASK_J;   // PULLUP ON


    // --------------------------------------------------------
    // PORTC
    // PC5, PC4, PC3, PC2, PC1, PC0
    // --------------------------------------------------------
    constexpr uint8_t MASK_C =
        (1 << PC5) |
        (1 << PC4) |
        (1 << PC3) |
        (1 << PC2) |
        (1 << PC1) |
        (1 << PC0);

    DDRC  &= ~MASK_C;   // INPUT
    PORTC |=  MASK_C;   // PULLUP ON


    // --------------------------------------------------------
    // PORTG
    // PG1, PG0, PG3
    // --------------------------------------------------------
    constexpr uint8_t MASK_G =
        (1 << PG1) |
        (1 << PG0) |
        (1 << PG3);

    DDRG  &= ~MASK_G;   // INPUT
    PORTG |=  MASK_G;   // PULLUP ON


    // --------------------------------------------------------
    // PORTL
    // PL3, PL2, PL1, PL0
    // --------------------------------------------------------
    constexpr uint8_t MASK_L =
        (1 << PL3) |
        (1 << PL2) |
        (1 << PL1) |
        (1 << PL0);

    DDRL  &= ~MASK_L;   // INPUT
    PORTL |=  MASK_L;   // PULLUP ON
}


// ============================================================
// 32個のセンサを読み取る
//
// 戻り値:
//   bit 0～31 に各センサのHIGH/LOWを格納
//
//   HIGH -> 1
//   LOW  -> 0
// ============================================================
uint32_t readSensors()
{
    uint32_t value = 0;


    // --------------------------------------------------------
    // レジスタを先に全部読み取る
    //
    // 同じポートは1回だけ読む
    // --------------------------------------------------------

    const uint8_t b = PINB;
    const uint8_t h = PINH;
    const uint8_t f = PINF;
    const uint8_t a = PINA;
    const uint8_t j = PINJ;
    const uint8_t c = PINC;
    const uint8_t g = PING;
    const uint8_t l = PINL;


    // --------------------------------------------------------
    // PORTB
    // --------------------------------------------------------

    value |= ((b >> PB7) & 1UL) << 0;
    value |= ((b >> PB6) & 1UL) << 1;
    value |= ((b >> PB5) & 1UL) << 2;
    value |= ((b >> PB4) & 1UL) << 3;
    value |= ((b >> PB0) & 1UL) << 4;


    // --------------------------------------------------------
    // PORTH
    // --------------------------------------------------------

    value |= ((h >> PH6) & 1UL) << 5;
    value |= ((h >> PH5) & 1UL) << 6;
    value |= ((h >> PH4) & 1UL) << 7;
    value |= ((h >> PH3) & 1UL) << 8;
    value |= ((h >> PH2) & 1UL) << 9;


    // --------------------------------------------------------
    // PORTF
    // --------------------------------------------------------

    value |= ((f >> PF6) & 1UL) << 10;
    value |= ((f >> PF7) & 1UL) << 11;


    // --------------------------------------------------------
    // PORTA
    // --------------------------------------------------------

    value |= ((a >> PA1) & 1UL) << 12;
    value |= ((a >> PA2) & 1UL) << 13;


    // --------------------------------------------------------
    // PORTJ
    // --------------------------------------------------------

    value |= ((j >> PJ6) & 1UL) << 14;
    value |= ((j >> PJ5) & 1UL) << 15;
    value |= ((j >> PJ4) & 1UL) << 16;
    value |= ((j >> PJ3) & 1UL) << 17;


    // --------------------------------------------------------
    // PORTC
    // --------------------------------------------------------

    value |= ((c >> PC5) & 1UL) << 18;
    value |= ((c >> PC4) & 1UL) << 19;
    value |= ((c >> PC3) & 1UL) << 20;
    value |= ((c >> PC2) & 1UL) << 21;
    value |= ((c >> PC1) & 1UL) << 22;
    value |= ((c >> PC0) & 1UL) << 23;


    // --------------------------------------------------------
    // PORTG
    // --------------------------------------------------------

    value |= ((g >> PG1) & 1UL) << 24;
    value |= ((g >> PG0) & 1UL) << 25;


    // --------------------------------------------------------
    // PORTL
    // --------------------------------------------------------

    value |= ((l >> PL3) & 1UL) << 26;
    value |= ((l >> PL2) & 1UL) << 27;
    value |= ((l >> PL1) & 1UL) << 28;
    value |= ((l >> PL0) & 1UL) << 29;


    // --------------------------------------------------------
    // PG3
    // --------------------------------------------------------

    value |= ((g >> PG3) & 1UL) << 30;


    // --------------------------------------------------------
    // PH7
    // --------------------------------------------------------

    value |= ((h >> PH7) & 1UL) << 31;


    return value;
}


// ============================================================
// setup
// ============================================================
void setup()
{
    Serial.begin(115200);

    initSensors();

    analogWrite(2, 100);
    analogWrite(3, 100);
    analogWrite(4, 100);
    analogWrite(5, 100);
}


// ============================================================
// loop
// ============================================================
void loop()
{
    uint32_t sensors = readSensors();


    // --------------------------------------------------------
    // デバッグ用：32bitのセンサ状態を表示
    // --------------------------------------------------------

    Serial.print("Sensors: ");

    for (int i = 31; i >= 0; --i) {
        Serial.print((sensors >> i) & 1UL);
    }

    Serial.println();

    // --------------------------------------------------------
    // 個別に読み取る例
    // --------------------------------------------------------

    // bit 0 = PB7
    bool sensor0 = (sensors & (1UL << 0)) != 0;

    // bit 1 = PB6
    bool sensor1 = (sensors & (1UL << 1)) != 0;

    // bit 31 = PH7
    bool sensor31 = (sensors & (1UL << 31)) != 0;


    // 例：
    // if (sensor0) {
    //     // PB7がHIGH
    // }


    // --------------------------------------------------------
    // 必要に応じて待機
    // --------------------------------------------------------
    delay(100);
}